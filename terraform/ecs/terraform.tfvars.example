# Copy to terraform.tfvars (git-ignored).
# region  = "ap-southeast-2"
# domain  = "zuchat.foonix.net"

deepseek_secret_arn      = "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT:secret:zuchat/deepseek-XXXXXX"
session_secret_arn       = "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT:secret:zuchat/session-XXXXXX"
google_client_secret_arn = "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT:secret:zuchat/google-secret-XXXXXX"

google_client_id = "000000000000-xxxxxxxx.apps.googleusercontent.com"
allowed_emails   = "you@example.com"  # empty string admits any Google account

# Optional; these are the defaults. 0 disables any individual control.
# max_output_tokens             = 1024
# max_concurrent_per_user       = 1
# max_concurrent_total          = 8
# session_max_age_seconds       = 86400
# max_body_bytes                = 65536
# rate_limit_per_minute         = 10
# rate_limit_global_per_minute  = 60
# token_budget_per_day          = 100000
# token_budget_global_per_day   = 1000000
